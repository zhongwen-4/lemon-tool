<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只有「检查更新」用得到网络；扫描模块全程离线。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- miuix-blur:0.9.4 的 manifest 硬要求 minSdkVersion 33，而本项目是 24。                   上游 SukiSU（minSdk 26）就是这么放行的：库在低版本上只做运行时门控，不会真去调高版本 API。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 平台级的预测性返回 opt-in：API 33/34 上不加它，关于页的「跟手滑出」收不到进度回调；
         API 35+（targetSdk 33+）平台默认就开着，这个属性会被忽略。
         2026-09-30 起它只是「出厂默认」：运行时会按设置里的「预测性返回手势」开关被 MrsApplication
         用隐藏 API 翻掉（上游同款），所以这里固定写 true。-->
    <application
        android:name=".MrsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mrs"
        tools:targetApi="33"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
